# RailFood Backend Environment Configuration
ENVIRONMENT=production
SECRET_KEY=railfood_secure_random_key_change_in_production_xyz123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Connection (AWS RDS Free Tier or Local Postgres)
DATABASE_URL=postgresql://postgres:YourSecurePassword123@railfood-db.cxxxxxx.ap-south-1.rds.amazonaws.com:5432/railfood_db

# AWS Region & Credentials (On EC2 with IAM Role attached, ACCESS_KEY_ID & SECRET can be omitted)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 Bucket (SSE-S3 enabled)
S3_BUCKET_NAME=railfood-production-assets
S3_CUSTOM_DOMAIN=

# AWS SES Sender (Must be verified in AWS SES Console)
SES_REGION=ap-south-1
SES_SENDER_EMAIL=orders@railfood.app
